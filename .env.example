# Application Configuration
APP_NAME=polis
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///polis.db
DATABASE_ECHO=false

# Vector Store Configuration
VECTOR_STORE_URL=localhost:6333

# Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_REASONING_ENGINE=true
ENABLE_GOVERNANCE_ENGINE=true

# Calendar Agent Configuration
CALENDAR_REMINDER_OFFSET_HOURS=15
CALENDAR_WORKER_POLL_INTERVAL_SECONDS=30
CALENDAR_ORGANIZATION_CHANNEL=
CALENDAR_DEFAULT_TIMEZONE=Asia/Kolkata
CALENDAR_MAX_RETRY_ATTEMPTS=3

# Slack Connector & OAuth Scopes
# Required Scopes: channels:history, groups:history, im:history, mpim:history,
#                  channels:read, groups:read, im:read, mpim:read,
#                  chat:write, users:read, users:read.email
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_BOT_USER_ID=

# Microsoft Teams / Microsoft Graph Configuration
# Required Application Permissions: ChannelMessage.Read.All, Chat.Read.All,
#                                   Chat.ReadWrite, Team.ReadBasic.All, OnlineMeetings.Read.All
MICROSOFT_GRAPH_TENANT_ID=your-azure-tenant-id
MICROSOFT_GRAPH_CLIENT_ID=your-azure-client-id
MICROSOFT_GRAPH_CLIENT_SECRET=your-azure-client-secret
TEAMS_WEBHOOK_URL=

# HR & Employee Directory Providers (Optional)
BAMBOOHR_API_KEY=
BAMBOOHR_SUBDOMAIN=
WORKDAY_API_ENDPOINT=
WORKDAY_CLIENT_ID=
WORKDAY_CLIENT_SECRET=

# Project Management Providers (Optional)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
LINEAR_API_KEY=
GITHUB_TOKEN=
GITHUB_ORG=
